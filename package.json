{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/vite/bin/vite.js build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.app.json",
    "test:admin": "node --test tests/admin-*.test.mjs",
    "dev:codespace": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "db:status": "node scripts/supabase-migrate.mjs --status",
    "db:migrate": "node scripts/supabase-migrate.mjs",
    "test:workflow": "node --test tests/migration-workflow.test.mjs tests/codex-history.test.mjs",
    "deploy:check": "node scripts/deploy.mjs",
    "deploy": "node scripts/deploy.mjs",
    "check": "npm run typecheck && npm run test:admin && npm run test:workflow && npm run build",
    "history:backup": "node scripts/codex-history.mjs --start",
    "history:restore": "node scripts/codex-history.mjs --restore"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "html-to-image": "^1.11.13",
    "html2canvas-pro": "^2.4.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.33.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "supabase": "2.117.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  },
  "engines": {
    "node": "24.x"
  }
}
