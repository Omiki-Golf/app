# Supabase Configuration
# Obtén estas credenciales desde https://app.supabase.com
# Proyecto → Settings → API

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anon_publica_aqui

# Admin Configuration
# Cambia estos valores después del despliegue

VITE_ADMIN_EMAIL=tu@email.com
VITE_ADMIN_PIN=2248

# ============================================================
# NOTAS IMPORTANTES:
# ============================================================
#
# 1. NUNCA subas el archivo .env a Git (ya está en .gitignore)
#
# 2. El prefijo VITE_ hace que estas variables sean accesibles
#    en el código del navegador. Esto es intencional.
#
# 3. Para Vercel/Netlify, añade estas mismas variables en la
#    configuración del proyecto (sin el archivo .env)
#
# 4. VITE_SUPABASE_ANON_KEY es pública y segura para el frontend
#    NUNCA uses la service_role_key en frontend
#
# ============================================================
# SETUP RÁPIDO:
# ============================================================
#
# 1. Copia este archivo:
#    cp .env.example .env
#
# 2. Edita .env con tus credenciales reales
#
# 3. Reinicia el servidor de desarrollo:
#    npm run dev
#
# ============================================================
VITE_ENABLE_LOCAL_AI=false
VITE_LOCAL_AI_MODEL=llama3.2
